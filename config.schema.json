{
  "pluginAlias": "BrotherPrinter",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Shows Brother laser and inkjet printers in HomeKit: printing state, problems, and toner or ink levels. SNMP must be on in the printer's web page (Network > Protocol).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform name",
        "type": "string",
        "default": "Brother Printer"
      },
      "printers": {
        "title": "Printers",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "default": "Printer"
            },
            "host": {
              "title": "IP address or hostname",
              "type": "string",
              "placeholder": "10.0.4.150",
              "description": "Required. Printers without an address are ignored."
            },
            "community": {
              "title": "SNMP community",
              "type": "string",
              "default": "public"
            },
            "port": {
              "title": "SNMP port",
              "type": "integer",
              "default": 161,
              "minimum": 1,
              "maximum": 65535
            },
            "snmpVersion": {
              "title": "SNMP version",
              "type": "string",
              "default": "auto",
              "oneOf": [
                {
                  "title": "Automatic (v2c, then v1)",
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "title": "v2c",
                  "enum": [
                    "2c"
                  ]
                },
                {
                  "title": "v1 (older printers)",
                  "enum": [
                    "1"
                  ]
                },
                {
                  "title": "v3 (user name and passwords)",
                  "enum": [
                    "3"
                  ]
                }
              ]
            },
            "v3User": {
              "title": "SNMPv3 user name",
              "type": "string",
              "description": "As set in the printer's web page: Network > Protocol > SNMP."
            },
            "v3AuthProtocol": {
              "title": "SNMPv3 authentication",
              "type": "string",
              "default": "sha",
              "oneOf": [
                { "title": "None", "enum": ["none"] },
                { "title": "MD5", "enum": ["md5"] },
                { "title": "SHA-1", "enum": ["sha"] },
                { "title": "SHA-224", "enum": ["sha224"] },
                { "title": "SHA-256", "enum": ["sha256"] },
                { "title": "SHA-384", "enum": ["sha384"] },
                { "title": "SHA-512", "enum": ["sha512"] }
              ]
            },
            "v3AuthPassword": {
              "title": "SNMPv3 authentication password",
              "type": "string",
              "description": "At least 8 characters."
            },
            "v3PrivProtocol": {
              "title": "SNMPv3 encryption (privacy)",
              "type": "string",
              "default": "aes",
              "oneOf": [
                { "title": "None", "enum": ["none"] },
                { "title": "DES", "enum": ["des"] },
                { "title": "AES-128", "enum": ["aes"] },
                { "title": "AES-256 (Blumenthal)", "enum": ["aes256b"] },
                { "title": "AES-256 (Reeder)", "enum": ["aes256r"] }
              ]
            },
            "v3PrivPassword": {
              "title": "SNMPv3 encryption password",
              "type": "string",
              "description": "At least 8 characters."
            },
            "pollInterval": {
              "title": "Poll every (seconds)",
              "type": "integer",
              "default": 60,
              "minimum": 10,
              "maximum": 3600
            },
            "lowTonerThreshold": {
              "title": "Toner / ink low at (%)",
              "type": "integer",
              "default": 10,
              "minimum": 0,
              "maximum": 100,
              "description": "On color printers, the battery shows the lowest color and turns low when any color reaches this."
            },
            "lowTonerSensor": {
              "title": "Low toner sensor",
              "type": "boolean",
              "default": false,
              "description": "Adds a contact sensor that opens when toner or ink is low, so Home notifies \"Printer Toner Low opened\" instead of \"battery is low\". Turn on notifications for it in the Home app."
            },
            "showDrum": {
              "title": "Show drum life as a second battery",
              "type": "boolean",
              "default": false,
              "description": "Apple's Home app shows only one battery per accessory, and may pick the drum over the toner. Leave off unless you use Eve or another app that shows both."
            },
            "lowDrumThreshold": {
              "title": "Drum and parts low at (%)",
              "type": "integer",
              "default": 10,
              "minimum": 0,
              "maximum": 100,
              "description": "Logs a warning when the drum, belt, fuser, laser unit, paper feed kit or ink waste box reaches this."
            },
            "tonerTile": {
              "title": "Show toner / ink % on tiles",
              "description": "Adds a humidity sensor whose value is the level: one for a mono printer, one per color for a color printer. They also count in Home's climate summary.",
              "type": "boolean",
              "default": false
            },
            "maintenanceSensor": {
              "title": "Maintenance sensor",
              "type": "boolean",
              "default": false,
              "description": "Adds a contact sensor that opens when the drum or another part (belt, fuser, laser unit, paper feed kit, ink waste box) reaches the parts threshold, so Home can notify it."
            },
            "paperSensor": {
              "title": "Out of paper sensor",
              "type": "boolean",
              "default": false,
              "description": "Adds a contact sensor that opens when a tray is out of paper, so Home notifies \"Printer Out of Paper opened\". The Problem sensor opens for this too."
            },
            "onlineSensor": {
              "title": "Online sensor",
              "type": "boolean",
              "default": false,
              "description": "Adds an occupancy sensor that's Detected while the printer answers, for automations such as turning off its smart plug. Unlike the other sensors it doesn't show No Response when the printer is offline."
            },
            "faultSensor": {
              "title": "Problem sensor",
              "description": "Adds a contact sensor that opens on a jam, open cover, empty tray or other error, so Home can show and notify it.",
              "type": "boolean",
              "default": true
            },
            "offlineAfter": {
              "title": "Mark offline after (failed polls)",
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 20
            },
            "debug": {
              "title": "Log every poll",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    {
      "key": "printers",
      "type": "array",
      "orderable": false,
      "buttonText": "Add printer",
      "items": [
        {
          "type": "section",
          "items": [
            "printers[].name",
            "printers[].host",
            {
              "type": "fieldset",
              "title": "Sensors",
              "expandable": true,
              "items": [
                "printers[].lowTonerThreshold",
                "printers[].lowTonerSensor",
                "printers[].showDrum",
                "printers[].lowDrumThreshold",
                "printers[].tonerTile",
                "printers[].faultSensor",
                "printers[].paperSensor",
                "printers[].maintenanceSensor",
                "printers[].onlineSensor"
              ]
            },
            {
              "type": "fieldset",
              "title": "Advanced",
              "expandable": true,
              "items": [
                "printers[].community",
                {
                  "key": "printers[].port",
                  "type": "number"
                },
                "printers[].snmpVersion",
                { "key": "printers[].v3User", "condition": { "functionBody": "return model.printers && model.printers[arrayIndices] && model.printers[arrayIndices].snmpVersion === '3';" } },
                { "key": "printers[].v3AuthProtocol", "condition": { "functionBody": "return model.printers && model.printers[arrayIndices] && model.printers[arrayIndices].snmpVersion === '3';" } },
                { "key": "printers[].v3AuthPassword", "type": "password", "condition": { "functionBody": "return model.printers && model.printers[arrayIndices] && model.printers[arrayIndices].snmpVersion === '3';" } },
                { "key": "printers[].v3PrivProtocol", "condition": { "functionBody": "return model.printers && model.printers[arrayIndices] && model.printers[arrayIndices].snmpVersion === '3';" } },
                { "key": "printers[].v3PrivPassword", "type": "password", "condition": { "functionBody": "return model.printers && model.printers[arrayIndices] && model.printers[arrayIndices].snmpVersion === '3';" } },
                {
                  "key": "printers[].pollInterval",
                  "type": "number"
                },
                {
                  "key": "printers[].offlineAfter",
                  "type": "number"
                },
                "printers[].debug"
              ]
            }
          ]
        }
      ]
    }
  ]
}
