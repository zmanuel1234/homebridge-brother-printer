{
  "pluginAlias": "BrotherPrinter",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Shows Brother laser and inkjet printers in HomeKit: printing state, problems, and toner or ink levels. SNMP must be on in the printer's web page (Network > Protocol).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform name",
        "type": "string",
        "default": "Brother Printer"
      },
      "printers": {
        "title": "Printers",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "default": "Printer"
            },
            "host": {
              "title": "IP address or hostname",
              "type": "string",
              "placeholder": "10.0.4.150",
              "description": "Required. Printers without an address are ignored."
            },
            "community": {
              "title": "SNMP community",
              "type": "string",
              "default": "public"
            },
            "port": {
              "title": "SNMP port",
              "type": "integer",
              "default": 161,
              "minimum": 1,
              "maximum": 65535
            },
            "snmpVersion": {
              "title": "SNMP version",
              "type": "string",
              "default": "auto",
              "oneOf": [
                {
                  "title": "Automatic (v2c, then v1)",
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "title": "v2c",
                  "enum": [
                    "2c"
                  ]
                },
                {
                  "title": "v1 (older printers)",
                  "enum": [
                    "1"
                  ]
                }
              ]
            },
            "pollInterval": {
              "title": "Poll every (seconds)",
              "type": "integer",
              "default": 60,
              "minimum": 10,
              "maximum": 3600
            },
            "lowTonerThreshold": {
              "title": "Toner / ink low at (%)",
              "type": "integer",
              "default": 10,
              "minimum": 0,
              "maximum": 100,
              "description": "On color printers, the battery shows the lowest color and turns low when any color reaches this."
            },
            "showDrum": {
              "title": "Show drum life as a second battery",
              "type": "boolean",
              "default": false,
              "description": "Apple's Home app shows only one battery per accessory, and may pick the drum over the toner. Leave off unless you use Eve or another app that shows both."
            },
            "lowDrumThreshold": {
              "title": "Drum and parts low at (%)",
              "type": "integer",
              "default": 10,
              "minimum": 0,
              "maximum": 100,
              "description": "Logs a warning when the drum, belt, fuser, laser unit, paper feed kit or ink waste box reaches this."
            },
            "tonerTile": {
              "title": "Show toner / ink % on tiles",
              "description": "Adds a humidity sensor whose value is the level: one for a mono printer, one per color for a color printer. They also count in Home's climate summary.",
              "type": "boolean",
              "default": false
            },
            "faultSensor": {
              "title": "Problem sensor",
              "description": "Adds a contact sensor that opens on a jam, open cover, empty tray or other error, so Home can show and notify it.",
              "type": "boolean",
              "default": true
            },
            "offlineAfter": {
              "title": "Mark offline after (failed polls)",
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 20
            },
            "debug": {
              "title": "Log every poll",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  },
  "layout": [
    "name",
    {
      "key": "printers",
      "type": "array",
      "orderable": false,
      "buttonText": "Add printer",
      "items": [
        {
          "type": "section",
          "items": [
            "printers[].name",
            "printers[].host",
            {
              "type": "fieldset",
              "title": "Sensors",
              "expandable": true,
              "items": [
                "printers[].lowTonerThreshold",
                "printers[].showDrum",
                "printers[].lowDrumThreshold",
                "printers[].tonerTile",
                "printers[].faultSensor"
              ]
            },
            {
              "type": "fieldset",
              "title": "Advanced",
              "expandable": true,
              "items": [
                "printers[].community",
                {
                  "key": "printers[].port",
                  "type": "number"
                },
                "printers[].snmpVersion",
                {
                  "key": "printers[].pollInterval",
                  "type": "number"
                },
                {
                  "key": "printers[].offlineAfter",
                  "type": "number"
                },
                "printers[].debug"
              ]
            }
          ]
        }
      ]
    }
  ]
}
