{
  "name": "homebridge-brother-printer",
  "displayName": "Brother Printer",
  "version": "0.4.0",
  "description": "Brother laser and inkjet printers in HomeKit: printing state, problem alerts and toner or ink levels, read locally over SNMP.",
  "author": "Manuel Zamfir",
  "license": "MIT",
  "homepage": "https://github.com/zmanuel1234/homebridge-brother-printer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-brother-printer.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-brother-printer/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "brother-printer-probe": "dist/bin/brother-printer-probe.js"
  },
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supports-hap",
    "homekit",
    "brother",
    "printer",
    "laser",
    "inkjet",
    "toner",
    "ink",
    "snmp"
  ],
  "engines": {
    "node": "^18.20.0 || ^20.15.0 || ^22.0.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "dependencies": {
    "net-snmp": "^3.29.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^18.19.130",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "homebridge": "^2.5.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  }
}
