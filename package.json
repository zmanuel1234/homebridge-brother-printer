{
  "name": "homebridge-brother-printer",
  "displayName": "Brother Printer",
  "version": "0.10.0",
  "description": "Printers in HomeKit, any make (Brother in most detail): printing state, problem alerts, toner or ink levels and paper trays, read locally over SNMP or IPP (AirPrint).",
  "author": "Manuel Zamfir",
  "license": "MIT",
  "homepage": "https://github.com/zmanuel1234/homebridge-brother-printer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-brother-printer.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-brother-printer/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/zmanuel1234"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/zmanuel"
    }
  ],
  "main": "dist/index.js",
  "bin": {
    "brother-printer-probe": "dist/bin/brother-printer-probe.js"
  },
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/homebridge-ui/public','dist/homebridge-ui/public',{recursive:true})\"",
    "check": "tsc -p .",
    "lint": "oxlint && npm run check",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test",
    "verify": "npm run lint && npm run build && npm test",
    "test:matrix": "npm run build && npm test",
    "release:check": "npm run verify"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supports-hap",
    "homekit",
    "brother",
    "printer",
    "laser",
    "inkjet",
    "toner",
    "ink",
    "snmp",
    "laser-printer",
    "mfc",
    "dcp",
    "drum",
    "out-of-paper",
    "ipp",
    "airprint",
    "bonjour",
    "hp",
    "canon",
    "epson",
    "lexmark",
    "dashboard"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.3.0",
    "fakegato-history": "^0.6.7",
    "net-snmp": "^3.29.2"
  },
  "devDependencies": {
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.20.5",
    "homebridge": "^2.5.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
