{
  "name": "homebridge-brother-printer",
  "displayName": "Brother Printer",
  "version": "0.4.0",
  "description": "Brother laser and inkjet printers in HomeKit: printing state, problem alerts and toner or ink levels, read locally over SNMP.",
  "author": "Manuel Zamfir",
  "license": "MIT",
  "homepage": "https://github.com/zmanuel1234/homebridge-brother-printer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmanuel1234/homebridge-brother-printer.git"
  },
  "bugs": {
    "url": "https://github.com/zmanuel1234/homebridge-brother-printer/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "brother-printer-probe": "dist/bin/brother-printer-probe.js"
  },
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "lint": "eslint . --max-warnings=0 && npm run typecheck",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supports-hap",
    "homekit",
    "brother",
    "printer",
    "laser",
    "inkjet",
    "toner",
    "ink",
    "snmp"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "dependencies": {
    "net-snmp": "^3.29.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "homebridge": "^2.5.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
